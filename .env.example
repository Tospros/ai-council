# LLM Red Team Configuration

# Development mode (all models on localhost)
DEV_MODE=true

# Jetson Nano hosts (for production)
JETSON_1_HOST=jetson-nano-1.local
JETSON_2_HOST=jetson-nano-2.local
JETSON_3_HOST=jetson-nano-3.local

# Raspberry Pi host (target model)
RASPBERRY_PI_HOST=raspberry-pi.local

# Ollama port (default: 11434)
OLLAMA_PORT=11434

# Django settings
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=true

# Database URL
DATABASE_URL=sqlite:///./llm_redteam.db
