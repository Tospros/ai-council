# ===== Backend AI Council =====
# URL do LLM API (ollama-models-with-api)
LLM_API_URL=http://localhost:8080
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://aicouncil:aicouncil123@localhost:5432/ai_council

# ===== Security =====
SECRET_KEY=your-super-secret-key-change-this-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ===== CORS =====
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:8000"]

# ===== LLM API Keys =====
# OpenAI (GPT-4)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# Google (Gemini)
GOOGLE_API_KEY=your-google-api-key-here

# ===== LLM Models =====
GPT_MODEL=gpt-4
CLAUDE_MODEL=claude-3-opus-20240229
GEMINI_MODEL=gemini-pro

# ===== Rate Limiting =====
RATE_LIMIT_PER_MINUTE=10

# ===== Docker Ports =====
API_PORT=8000
POSTGRES_PORT=5432
PGADMIN_PORT=5050

# ===== pgAdmin (opcjonalnie) =====
PGADMIN_EMAIL=admin@aicouncil.local
PGADMIN_PASSWORD=admin123
